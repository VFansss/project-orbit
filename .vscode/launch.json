{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug Orbit Search",
      "program": "${workspaceFolder}/packages/cli/src/index.ts",
      "args": ["search", "online", "Metal Gear"],
      "noDebug": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug Orbit Screenshot",
      "program": "${workspaceFolder}/packages/cli/src/index.ts",
      "args": ["screenshot", "import"],
      "noDebug": false,
      "cwd": "${workspaceFolder}"
    }
  ]
}
