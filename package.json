{
  "name": "project-orbit",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "orbit": "bun run packages/cli/src/index.ts",
    "build:linux": "bun build ./packages/cli/src/index.ts --compile --minify --outfile ./dist/orbit-linux-x64",
    "build:windows": "bun build ./packages/cli/src/index.ts --compile --minify --outfile ./dist/orbit-windows-x64.exe --target bun-windows-x64",
    "build:all": "bun run build:linux && bun run build:windows"
  },
  "devDependencies": {
    "@types/node": "latest",
    "bun-types": "^1.3.13",
    "typescript": "latest"
  }
}
